ANTHROPIC_API_KEY=your_api_key_here

# Production domain (used by docker-compose + Caddy for automatic HTTPS)
DOMAIN=agent.your-domain.com

# Feishu (Lark) Open Platform — required for card button callbacks
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key   # optional, leave empty if encryption is off
